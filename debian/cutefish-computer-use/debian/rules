#!/usr/bin/make -f

# The crates come from Debian's librust-*-dev packages, through the
# project's .cargo/config.toml.
export CARGO_HOME = $(CURDIR)/debian/cargo-home

%:
	dh $@

override_dh_auto_build:
	cargo build --release --offline

override_dh_auto_test:
	cargo test --release --offline

# The compositor only trusts the server at this path.
override_dh_auto_install:
	install -D -m 755 target/release/cutefish-computer-use \
		debian/cutefish-computer-use/usr/bin/cutefish-computer-use

override_dh_auto_clean:
	rm -rf target debian/cargo-home
