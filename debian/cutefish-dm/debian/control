Maintainer: Reion Wong <reionwong@gmail.com>
Build-Depends: cmake (>= 3.22),
               debhelper-compat (= 13),
               cutefish-toolkit,
               libpam0g-dev,
               libsystemd-dev
Standards-Version: 4.7.2
Homepage: https://github.com/cutefishos/cutefish-dm

Package: cutefish-dm
Architecture: any
Depends: adduser,
         cutefish-compositor,
         ${misc:Depends},
         ${shlibs:Depends}
Description: CutefishOS display manager
 Runs the Cutefish login screen and the Wayland session a user logs in to,
 Cutefish or any other desktop in wayland-sessions, and hands the display
 between them without a black frame or the console in between.
